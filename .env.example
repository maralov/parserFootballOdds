# ─── Source ───────────────────────────────────────────────────────────────────
LIVE_BASE_URL=https://www.flashscore.mobi/?s=2

# ─── Working hours ─────────────────────────────────────────────────────────────
# Set to 1 to run 24/7 (ignore hour window)
LIVE_IGNORE_HOURS=0
LIVE_WORKING_HOURS_START=16
LIVE_WORKING_HOURS_END=23

# ─── Sleep policy ──────────────────────────────────────────────────────────────
LIVE_MIN_SLEEP_MS=60000
LIVE_MAX_SLEEP_MS=480000
LIVE_FALLBACK_SLEEP_MS=300000
# Wake up at this minute to catch halftime (44 = just before 45')
LIVE_TARGET_MINUTE=44

# ─── HTTP fetcher ──────────────────────────────────────────────────────────────
LIVE_HTTP_MAX_RETRIES=3
LIVE_HTTP_BASE_DELAY_MS=1000

# ─── Browser fetcher (Playwright fallback) ─────────────────────────────────────
LIVE_BROWSER_TIMEOUT_MS=30000
# Restart browser after this many ms (10 min)
LIVE_BROWSER_MAX_LIFETIME_MS=600000

# ─── Logging ───────────────────────────────────────────────────────────────────
# Levels: debug | info | warn | error
LOG_LEVEL=info

# ─── Telegram ─────────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Stage 2 — Enrichment ──────────────────────────────────────────────────────
# Set to 0 to disable enrichment
LIVE_ENRICHMENT_ENABLED=1
# Max parallel enrichment workers
LIVE_ENRICHMENT_CONCURRENCY=3
# Per-page timeout (ms)
LIVE_ENRICHMENT_TIMEOUT_MS=15000
# Delay range between requests per candidate (ms)
LIVE_ENRICHMENT_DELAY_MIN_MS=500
LIVE_ENRICHMENT_DELAY_MAX_MS=1500
# Bookmaker threshold: odds below this = favorite
LIVE_ODDS_FAVORITE_THRESHOLD=1.8

# ─── Stage 3 — Snapshot Tracker ────────────────────────────────────────────────
# Set to 0 to disable live snapshot tracking
LIVE_TRACKER_ENABLED=1
# Max parallel snapshot workers (keep low to avoid anti-bot)
LIVE_TRACKER_CONCURRENCY=2
# Delay from discoveredAt to first snapshot (ms) — 18 min
LIVE_TRACKER_FIRST_SNAPSHOT_OFFSET_MS=1080000
# Interval between snapshots (ms) — 5 min
LIVE_TRACKER_INTERVAL_MS=300000
# Random jitter added to each schedule (ms) — ±15 s
LIVE_TRACKER_JITTER_MS=15000
# Retry delay when match is still in halftime (ms) — 2 min
LIVE_TRACKER_HALFTIME_RETRY_MS=120000
# Hard timeout from discoveredAt after which match → stale (ms) — 120 min
LIVE_TRACKER_HARD_TIMEOUT_MS=7200000
# Consecutive fetch failures before marking stale
LIVE_TRACKER_MAX_FAILURES=3
# Goals before this minute → discard (not valid for prediction)
LIVE_TRACKER_DISCARD_BEFORE_MINUTE=60
# validForPrediction flag is set when we first reach this minute with 0:0
LIVE_TRACKER_VALID_FROM_MINUTE=60

# ─── Stage 4 — AI Enrichment ───────────────────────────────────────────────────
# Set to 1 to enable AI match analysis checkpoints
LIVE_AI_ENABLED=0
OPENAI_API_KEY=
LIVE_AI_MODEL=gpt-4o
LIVE_AI_MAX_RETRIES=2
LIVE_AI_TIMEOUT_MS=15000
LIVE_AI_TEMPERATURE=0.2
LIVE_AI_MAX_TOKENS=500
# Skip halftime AI when first-half total xG is at or above this threshold
LIVE_AI_HT_XG_THRESHOLD=1.5

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Тег у повідомленнях Telegram (паралельно v2/v3 на різних серверах), напр. v3
# TELEGRAM_MODEL_TAG=v3

# Яку модель викликати у worker: v2 (за замовчуванням) або v3 (форма/H2H bias у liveModelV3)
# LIVE_EVAL_MODEL=v3
# Локально без .env: npm run live:watch:v3 або npm run live:watch:v3:anytime

# Форма + очні з m.flashscore …/match/{id}/?t=h2h (скрейп; bias застосовується лише у v3)
# LIVE_FORM_H2H_ENABLED=1
# LIVE_FORM_H2H_MAX_FORM_ROWS=8
# LIVE_FORM_H2H_MAX_H2H_ROWS=8
# LIVE_PREMATCH_BIAS_CAP=0.045
LIVE_BASE_URL=https://m.flashscore.ua/?s=2
LIVE_POLL_INTERVAL_MS=180000
STATS_CONCURRENCY=2
MIN_EDGE=0.05
# Мінімальна хвилина для кандидата 0:0 (раніше 60 — щоб до 60′ назбирати ≥2 зрізи статистики між циклами)
LIVE_MIN_CANDIDATE_MINUTE=52
# Початок вікон ТМ/ТБ v2 (зазвичай 60; має збігатися з логікою liveModelV2)
# LIVE_DECISION_WINDOW_START_MINUTE=60
# Тест поза робочими годинами: 1 / true / yes
LIVE_IGNORE_HOURS=1

# Зрізи raw2H: з якої хвилини (узгоджуйте з LIVE_MIN_CANDIDATE_MINUTE)
LIVE_SNAPSHOT_MIN_MINUTE=52
# Пауза + повторний scrape в одному циклі, якщо вже у вікні рішень, а зрізів < LIVE_V2_UNDER_CONFIRM_SNAPSHOTS (0 = вимкнено)
# LIVE_SNAPSHOT_SECOND_PASS_MS=45000
# ТМ 60–70: сплеск (вбудовано в v2; legacy гейт у windowedLiveDecision для replay)
LIVE_SNAPSHOT_BURST_GATE_ENABLED=1
LIVE_SNAPSHOT_BURST_MIN_SOT=2
LIVE_SNAPSHOT_BURST_MIN_XG=0.25

# --- Live model v2 (сегменти та снэпшоти) ---
LIVE_SEGMENT_STEP_MINUTES=5
LIVE_SNAPSHOT_HISTORY_MAX=24
LIVE_WINDOW_END_60_70=70
LIVE_WINDOW_END_70_80=80
LIVE_V2_MIN_SIGNAL_QUALITY_TELEGRAM=0.4
LIVE_V2_UNDER_CONFIRM_SNAPSHOTS=2
LIVE_V2_PDRY_MIN_60_70=0.52
LIVE_V2_PGOAL_MAX_60_70=0.48
LIVE_V2_PGOAL_MIN_70_80=0.58
LIVE_V2_PDRY_MIN_70_80=0.54
LIVE_V2_PGOAL_MIN_80=0.55
LIVE_V2_BURST_MIN_SOT=2
LIVE_V2_BURST_MIN_XG=0.25
LIVE_V2_LATE_SURGE_RATIO=1.18
# Опційно: JSON з ліговими нормами (поки не підключено до скрапера)
# LIVE_LEAGUE_BASELINE_PATH=
